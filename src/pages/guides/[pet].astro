---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PET_CATEGORIES } from '../../consts.js';
import { standaloneArticles } from '../../data/standaloneArticles.js';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return PET_CATEGORIES.map((cat) => ({
    params: { pet: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;

// Pull guides from the Astro content collection (Decap CMS articles, if any)
const allCollectionGuides = await getCollection('guides', ({ data }) => !data.draft);
const collectionGuidesForCategory = allCollectionGuides
  .filter((g) => g.data.pet === category.slug)
  .map((g) => ({
    url: `/guides/${g.data.pet}/${g.slug}/`,
    title: g.data.title,
    description: g.data.description,
    heroImage: typeof g.data.heroImage === 'string' ? g.data.heroImage : g.data.heroImage.src,
    heroImageAlt: g.data.heroImageAlt,
    pubDate: g.data.pubDate,
  }));

// Merge both sources, sort newest-first
const guides = [
  ...collectionGuidesForCategory,
  ...(standaloneArticles[category.slug] || []),
].sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

const title = `${category.name} Care Guides`;
const description = `Complete care guides for ${category.name.toLowerCase()} — ${category.description}`;
---

<BaseLayout title={title} description={description}>
  <section class="category-hero">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a> › <a href="/guides/">Guides</a> › <span aria-current="page">{category.name}</span>
      </div>
      <div style="font-size: 4rem; margin-bottom: 1rem;">{category.icon}</div>
      <h1>{title}</h1>
      <p class="hero-lede">{category.description}</p>
    </div>
  </section>

  <section class="container" style="padding: 3rem 1rem 5rem;">
    {guides.length === 0 ? (
      <div style="text-align: center; padding: 4rem 1rem; color: var(--text-muted);">
        <p style="font-size: 1.1rem;">New {category.name.toLowerCase()} guides are coming soon.</p>
        <p style="margin-top: 1rem;">
          In the meantime, <a href="/guides/">browse guides for other pets</a> or
          <a href={`/reviews/${category.slug}/`}>check out our {category.name.toLowerCase()} product reviews</a>.
        </p>
      </div>
    ) : (
      <div class="card-grid">
        {guides.map((post) => (
          <article class="post-card">
            <a href={post.url}>
              <div class="post-card-image">
                <img
                  src={post.heroImage}
                  alt={post.heroImageAlt}
                  loading="lazy"
                />
              </div>
              <div class="post-card-body">
                <div
                  class="post-card-category"
                  style={`background: ${category.colorTint}; color: ${category.colorText};`}
                >
                  {category.name}
                </div>
                <h3 class="post-card-title">{post.title}</h3>
                <p class="post-card-excerpt">{post.description}</p>
                <div class="post-card-meta">
                  {new Date(post.pubDate).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 28px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .post-card {
    background: white;
    border: 1px solid #E4E9F2;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(20, 30, 50, 0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(20, 30, 50, 0.10), 0 4px 8px rgba(20, 30, 50, 0.05);
  }

  .post-card a {
    text-decoration: none;
    color: inherit;
    display: block;
    height: 100%;
  }

  .post-card-image {
    aspect-ratio: 16 / 10;
    background: #EEF2F8;
    overflow: hidden;
  }

  .post-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .post-card:hover .post-card-image img {
    transform: scale(1.04);
  }

  .post-card-body {
    padding: 22px 24px 26px;
  }

  .post-card-category {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 99px;
    margin-bottom: 12px;
  }

  .post-card-title {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 600;
    font-size: 20px;
    line-height: 1.25;
    color: #141A26;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .post-card-excerpt {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 14px;
    line-height: 1.55;
    color: #525C6E;
    margin: 0 0 14px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-meta {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 12px;
    color: #7A8599;
    letter-spacing: 0.02em;
  }

  @media (max-width: 640px) {
    .card-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .post-card-body {
      padding: 18px 20px 22px;
    }
  }
</style>
