---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PET_CATEGORIES } from '../../consts.js';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return PET_CATEGORIES.map((cat) => ({
    params: { pet: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;

// === Standalone HTML articles (live in public/, not in content collection) ===
// To add a new standalone article: add an entry under the right category slug.
const standaloneArticles = {
  cats: [
    {
      url: '/guides/cats/ragdoll-cat-guide/',
      title: 'Ragdoll Cat Complete Care Guide: Temperament, Health, and the Best Products for 2026',
      description: 'Everything new and prospective Ragdoll owners need to know — temperament, lifespan, grooming, health concerns, and the products that genuinely serve this gentle, oversized breed.',
      heroImage: '/uploads/ragdoll-44.jpg',
      heroImageAlt: 'Adult Ragdoll cat with striking blue eyes and soft white-and-cream semi-long fur',
      pubDate: new Date('2026-05-16'),
    },
    {
      url: '/guides/cats/nutrition/wet-vs-dry-cat-food/',
      title: 'Wet vs Dry Cat Food: Which Is Actually Better in 2026?',
      description: 'The real differences between wet and dry food — hydration, protein quality, carb load, dental impact — and the 8 specific products that deliver in each category across price tiers.',
      heroImage: '/uploads/ragdoll-208.jpg',
      heroImageAlt: 'Adult cat resting peacefully in a relaxed pose',
      pubDate: new Date('2026-05-17'),
    },
  ],
};

// Pull guides from the Astro content collection (Decap CMS articles)
const allCollectionGuides = await getCollection('guides', ({ data }) => !data.draft);
const collectionGuidesForCategory = allCollectionGuides
  .filter((g) => g.data.pet === category.slug)
  .map((g) => ({
    url: `/guides/${g.data.pet}/${g.slug}/`,
    title: g.data.title,
    description: g.data.description,
    heroImage: typeof g.data.heroImage === 'string' ? g.data.heroImage : g.data.heroImage.src,
    heroImageAlt: g.data.heroImageAlt,
    pubDate: g.data.pubDate,
  }));

// Merge both sources, sort newest-first
const guides = [
  ...collectionGuidesForCategory,
  ...(standaloneArticles[category.slug] || []),
].sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

const title = `${category.name} Care Guides`;
const description = `Complete care guides for ${category.name.toLowerCase()} — ${category.description}`;
---

<BaseLayout title={title} description={description}>
  <section class="category-hero">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a> › <a href="/guides/">Guides</a> › <span aria-current="page">{category.name}</span>
      </div>
      <div style="font-size: 4rem; margin-bottom: 1rem;">{category.icon}</div>
      <h1>{title}</h1>
      <p class="hero-lede">{category.description}</p>
    </div>
  </section>

  <section class="container" style="padding: 3rem 1rem 5rem;">
    {guides.length === 0 ? (
      <div style="text-align: center; padding: 4rem 1rem; color: var(--text-muted);">
        <p style="font-size: 1.1rem;">New {category.name.toLowerCase()} guides are coming soon.</p>
        <p style="margin-top: 1rem;">
          In the meantime, <a href="/guides/">browse guides for other pets</a> or
          <a href={`/reviews/${category.slug}/`}>check out our {category.name.toLowerCase()} product reviews</a>.
        </p>
      </div>
    ) : (
      <div class="card-grid">
        {guides.map((post) => (
          <article class="post-card">
            <a href={post.url}>
              <div class="post-card-image">
                <img
                  src={post.heroImage}
                  alt={post.heroImageAlt}
                  loading="lazy"
                />
              </div>
              <div class="post-card-body">
                <div class="post-card-category">{category.name}</div>
                <h3 class="post-card-title">{post.title}</h3>
                <p class="post-card-excerpt">{post.description}</p>
                <div class="post-card-meta">
                  {new Date(post.pubDate).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
